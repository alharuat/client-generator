# ---------------------------------------------------------------------------
# Client Generator environment variables. Copy to .env and fill in.
# Never commit real values. On Vercel, set these in Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Phase 1: database (required) -----------------------------------------
# Supabase: use the pooled connection (port 6543, ?pgbouncer=true) for DATABASE_URL
# and the direct connection (port 5432) for DIRECT_URL, which migrations use.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agency"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/agency"

# --- Phase 1: access control (required in production) ---------------------
# Browser login (HTTP Basic). Without DASHBOARD_PASSWORD, production returns 503.
DASHBOARD_USER="admin"
DASHBOARD_PASSWORD=""
# Bearer token for API clients and cron (POST /api/jobs/run). 16+ chars.
# API tokens can read and create but can never decide approvals.
ADMIN_API_TOKEN=""

# --- Phase 1: optional -----------------------------------------------------
APP_URL="http://localhost:3000"
LOG_LEVEL="info"            # debug | info | warn | error
PRISMA_LOG_QUERIES="false"
# Only for `npm test` integration suites. Must be a throwaway database.
TEST_DATABASE_URL=""

# --- Phase 2: Google Places API (New) -------------------------------------
GOOGLE_PLACES_API_KEY=""

# --- Phase 3: Claude API ---------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""          # defaults chosen in Phase 3

# --- Phase 4: ClickUp ------------------------------------------------------
CLICKUP_API_TOKEN=""
CLICKUP_TEAM_ID=""
CLICKUP_SPACE_ID=""

# --- Phase 6: GitHub and Vercel -------------------------------------------
GITHUB_TOKEN=""             # fine-grained token: Administration + Contents (write) on the org/user
GITHUB_OWNER=""             # org or user that will own one repo per client site
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# --- Optional: Supabase storage/auth for generated sites -------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
